# Copy to .env. These values are embedded in the Android application.
# Use ONLY a publishable key (sb_publishable_...) or legacy anon key.
# Never put a secret/service_role key, database URL or password in EXPO_PUBLIC_*.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Required for authenticated EAS builds after `npx eas init` links the project.
# This is an Expo project UUID, not a signing credential.
EAS_PROJECT_ID=
